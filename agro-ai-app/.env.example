# Copy this file to .env and fill in your Supabase project's public values.
# Find these under Project Settings → API in your Supabase dashboard.
# These are safe to expose in the browser (the anon key is designed for that);
# your real secrets (ANTHROPIC_API_KEY, DATA_GOV_API_KEY) go into Supabase
# Edge Function secrets instead — see README.md.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
